// This is your Prisma schema file,

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model user {
  id        String   @id @default(uuid())
  avatar    String
  username  String   @unique
  email     String   @unique
  name      String?
  password  String
  phone     String
  country   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
