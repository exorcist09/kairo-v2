// This is your Prisma schema file,

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  avatar         String
  username       String           @unique
  email          String           @unique
  name           String?
  password       String
  phone          String?
  country        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workflows      Workflow[]
  credentials    Credential[]
  creditBalance  Int              @default(100)
  creditPurchase CreditPurchase[]
  creditLedgers  CreditLedger[]
}

enum WorkflowStatus {
  DRAFT
  ONGOING
  COMPLETED
  FAILED
}

model Workflow {
  id                  String         @id @default(uuid())
  workflowName        String
  workflowDescription String?
  workflowStatus      WorkflowStatus @default(DRAFT)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  nodes       Node[]
  connections Connection[]
}

enum NodeType {
  MANUAL_TRIGGER
  HTTP_TRIGGER
  OPENAI
  GEMINI
  SLACK
}

// one particular node in editor
model Node {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name     String
  type     NodeType
  position Json
  data     Json     @default("{}")

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")
}

// model connection represents the edges connection 
model Connection {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode   Node   @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)

  toNodeId String
  toNode   Node   @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  fromOutput String @default("main")
  toInput    String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
}

model Credential {
  id    String @id @default(uuid())
  type  String
  name  String
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model CreditPurchase {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId           String
  creditsPurchased Int
  creditPlan       CreditPlan? @relation(fields: [planId], references: [id])

  amountPaid Decimal
  currency   String  @default("INR")

  status PaymentStatus @default(PENDING)

  providerRefId     String? @unique // Razorpay order_id
  providerPaymentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditLedger CreditLedger?
}

enum LedgerEntryType {
  PURCHASE
  USAGE
  REFUND
  MONTHLY_FREE_RESET
}

// this would have a whole history of credits in users account liek when it was used as well, when refunded, when purchased, when bonus extra
model CreditLedger {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type         LedgerEntryType
  amount       Int
  balanceAfter Int

  purchaseId String?         @unique
  purchase   CreditPurchase? @relation(fields: [purchaseId], references: [id])

  createdAt DateTime @default(now())
}

enum CreditPlanType {
  FREE_TIER
  SMALL
  MEDIUM
  LARGE
  CUSTOM
}

// this is the schema of what a user can buy(plan)-> all sepearted from the user DB
model CreditPlan {
  id String @id @default(uuid())

  type           CreditPlanType @unique
  credits        Int?
  price          Decimal?       @db.Decimal(10, 2)
  pricePerCredit Decimal?       @db.Decimal(10, 4)

  minCredits Int?
  maxCredits Int?

  createdAt DateTime @default(now())

  purchases CreditPurchase[]
}
